# 공유 링크의 OG 태그가 절대 URL을 만들 때 기준이 되는 주소.
# 비워 두면 http://localhost:3000 으로 동작한다. 배포 시 운영 도메인으로 바꿀 것.
NEXT_PUBLIC_SITE_URL=

# 클라이언트 노출 — 카카오 콘솔의 플랫폼 > Web 도메인 화이트리스트로 방어한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
# 노출되면 타인이 쿼터를 소진시키고 그 비용은 우리 비즈월렛에서 나간다.
KAKAO_REST_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
